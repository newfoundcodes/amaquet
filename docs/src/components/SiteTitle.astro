---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="amaquet-site-title" aria-label={`${siteTitle} documentation home`}>
  <img src="/amaquet.png" width="40" height="40" alt="" class="amaquet-brand-logo" decoding="async" />
  <span class="amaquet-brand-label" translate="no">
    Amaquet Docs
  </span>
</a>

<style>
  .amaquet-site-title {
    display: inline-flex;
    min-width: 0;
    height: 2.5rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--amaquet-sidebar-foreground);
    text-decoration: none;
  }

  .amaquet-brand-logo {
    display: block;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    min-width: 2.5rem;
    max-width: 2.5rem;
    height: 2.5rem;
    min-height: 2.5rem;
    max-height: 2.5rem;
    border-radius: var(--amaquet-radius-lg);
    box-shadow: var(--amaquet-shadow-xs);
    object-fit: cover;
  }

  .amaquet-brand-label {
    overflow: hidden;
    color: var(--amaquet-sidebar-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
