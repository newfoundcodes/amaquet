<?xml version="1.0" encoding="UTF-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
  xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Amaquet"
    Manufacturer="Newfoundcodes"
    Version="$(var.ProductVersion)"
    UpgradeCode="7B7F7DD4-7B27-4B1C-A9AC-9E8B320C0F11"
    Scope="perMachine">

    <!-- The standard MSI maintenance entry provides uninstall and repair. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Amaquet is already installed." />
    <!-- Keep the MSI self-contained so repair does not require a separate cab1.cab file. -->
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AmaquetIcon" SourceFile="$(var.SourceDir)\amaquet.ico" />
    <Property Id="ARPPRODUCTICON" Value="AmaquetIcon" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="MainFeature" Title="Amaquet" Level="1">
      <ComponentGroupRef Id="AmaquetFiles" />
      <ComponentGroupRef Id="AmaquetServiceFiles" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Amaquet">
        <Directory Id="BIN_FOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AMAQUET_COMMON_FOLDER" Name="Amaquet">
        <Directory Id="AMAQUET_DATA_FOLDER" Name="data" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AmaquetFiles" Directory="BIN_FOLDER">
      <Component Id="AmaquetServer">
        <File Id="AmaquetServerExe" Source="$(var.SourceDir)\amaquet.exe" KeyPath="yes" />
        <Environment
          Id="AmaquetBinPath"
          Name="PATH"
          Action="set"
          Part="last"
          Permanent="no"
          System="yes"
          Value="[BIN_FOLDER]" />
        <ServiceInstall
          Id="AmaquetServiceInstall"
          Name="Amaquet"
          DisplayName="Amaquet"
          Description="Amaquet in-memory database service"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Vital="yes"
          Account="NT AUTHORITY\LocalService"
          Arguments="--config &quot;[#AmaquetServiceConfigFile]&quot;" />
        <ServiceControl
          Id="AmaquetServiceControl"
          Name="Amaquet"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
      <Component Id="AmaquetCli">
        <File Id="AmaquetCliExe" Source="$(var.SourceDir)\amaquet-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="AmaquetKeygen">
        <File Id="AmaquetKeygenExe" Source="$(var.SourceDir)\amaquet-keygen.exe" KeyPath="yes" />
      </Component>
      <Component Id="AmaquetRestore">
        <File Id="AmaquetRestoreExe" Source="$(var.SourceDir)\amaquet-restore.exe" KeyPath="yes" />
      </Component>
      <Component Id="AmaquetExampleConfig" Directory="INSTALLFOLDER">
        <File Id="AmaquetExampleConfigFile" Source="$(var.SourceDir)\amaquet.example.json" KeyPath="yes" />
      </Component>
      <Component Id="AmaquetReadme" Directory="INSTALLFOLDER">
        <File Id="AmaquetReadmeFile" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="AmaquetLicense" Directory="INSTALLFOLDER">
        <File Id="AmaquetLicenseFile" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AmaquetServiceFiles">
      <Component Id="AmaquetServiceConfig" Directory="AMAQUET_COMMON_FOLDER">
        <File
          Id="AmaquetServiceConfigFile"
          Name="amaquet.json"
          Source="$(var.SourceDir)\amaquet-service.json"
          KeyPath="yes" />
      </Component>
      <Component Id="AmaquetServiceData" Directory="AMAQUET_DATA_FOLDER">
        <CreateFolder>
          <util:PermissionEx
            User="NT AUTHORITY\LOCAL SERVICE"
            GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
